---
import Base from '../../layouts/Base.astro';
import { links } from '../../lib/posts';

// Oldest first, matching the timeline. Images live in public/timeline/ (.webp with .jpg fallback).
const stories = [
  { href: '/work/early-years', title: 'Early years', years: '2003–2013', line: 'From Call of Duty clan writer to running my own esports site.', image: 'tl-02-call-of-duty', tone: 'accent' },
  { href: '/work/fnatic', title: 'Fnatic', years: '2008–2011', line: 'From $200 a month as an editor to General Manager.', image: 'tl-03-fnatic-lan', tone: 'amber' },
  { href: '/work/faceit', title: 'FACEIT', years: '2012–2022', line: 'Ten years, from Quake Live to the London Major.', image: 'tl-04-faceit-arena', tone: 'bone' },
];

const testimonials = [
  {
    quote: 'Roald has been a great asset in running R6 EUL and events from 2020 to 2022. The operational items were in safe hands with him and his team. The collaboration was effective, and Roald made sure to implement feedback swiftly to run an efficient league. I was impressed with his problem-solving skills and agility to meet Ubisoft needs.',
    name: 'Christoph Thann',
    role: 'Associate Director, Esports, EMEA at Ubisoft',
    context: 'Worked together on the Rainbow Six European League program and R6 Majors at FACEIT.',
  },
  {
    quote: 'Roald consistently tackled obstacles head-on, leveraging expertise to develop creative solutions that propelled our esports programs to new heights.',
    name: 'Jaspreet Marwaha',
    role: 'Senior Manager at ESL FACEIT Group',
    context: 'Colleagues at FACEIT; Jaspreet led product for the media team coordinating departments across live events and broadcasts.',
  },
  {
    quote: 'ELO provided us with a solid foundation for our esports program and sales strategy. Their insights and thorough understanding of the industry helped us refine our vision. Their professionalism and dedication ensured a smooth and productive collaboration.\n\nWorking with ELO was a great experience. Their team delivered a clear and effective blueprint for our esports program and sales strategy. Their industry expertise and professionalism made a significant impact, helping us strengthen our approach and move forward with confidence.',
    name: 'Anmar Alharbi',
    role: 'CEO at Rize.gg',
    context: 'ELO delivered a report on market research, opportunities, and detailed product analysis.',
  },
  {
    quote: 'My time at Fnatic marked the highlight of my e-sports journalism career. I would like to say that this is thanks to Roald who is the best Editor in Chief I have worked under. He is extremely easy to approach which is important when dealing with a number of individuals working below you. If I ever had a problem or question, I could always go to Roald and be sure to get an answer for my question.\n\nWorking under Roald is the environment people dream of and when it comes to managing a group of individuals and getting them to get a job done, Roald is the obvious choice.',
    name: 'Maximilian Kieturakis',
    role: 'Editor at Fnatic',
    context: 'Worked directly under Roald while he was Editor-in-Chief at Fnatic.',
  },
];
---
<Base title="Work – Roald van Buuren" description="The longer stories behind the timeline, and what collaborators say about working together.">
  <section class="zone z-a">
    <div class="wrap page-head">
      <h1 class="h1">Work.</h1>
      <p class="sub">The longer stories behind the timeline.</p>
    </div>
  </section>
  <section class="wrap wlist" style="padding-bottom:clamp(90px,10vw,140px)">
    {stories.map((s) => (
      <a class={`wcard tone-${s.tone}`} href={s.href}>
        <div class="wcard-img">
          <picture>
            <source type="image/webp" srcset={`/timeline/${s.image}.webp`} />
            <img src={`/timeline/${s.image}.jpg`} alt="" width="1584" height="672" loading="lazy" decoding="async" />
          </picture>
        </div>
        <div class="wcard-body">
          <span class="wk-years">{s.years}</span>
          <h3 class="t">{s.title}</h3>
          <p class="s">{s.line}</p>
          <span class="rm">Read<svg viewBox="0 0 12 16" aria-hidden="true"><path d="M2 2L10 8L2 14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" /></svg></span>
        </div>
      </a>
    ))}
    <p class="meta wk-note">What I'm working on now, including our research, is at <a href={links.labs} target="_blank" rel="noopener">ELO Labs →<span class="vh"> (opens in a new tab)</span></a></p>
  </section>
  <section class="zone z-b testimonials">
    <div class="wrap">
      <div class="testimonials-head">
        <span class="wk-years">COLLABORATORS</span>
        <h2 class="h2">In their words.</h2>
      </div>
      <div class="voices" data-voices>
        <div class="voice-tabs">
          <div class="starry-sky" role="tablist" aria-label="Choose a collaborator">
            <svg class="starry-paint" viewBox="0 0 1000 270" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <linearGradient id="starry-sky-wash" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#182858"/><stop offset="1" stop-color="#10172f"/></linearGradient>
                <radialGradient id="starry-light"><stop stop-color="#fff2be"/><stop offset=".26" stop-color="#f5cf75"/><stop offset="1" stop-color="#e8a33d" stop-opacity="0"/></radialGradient>
              </defs>
              <rect width="1000" height="270" fill="url(#starry-sky-wash)"/>
              <path d="M-20 180C100 130 120 36 250 54s143 176 277 116 148-157 275-104 127 106 226 52" fill="none" stroke="#304c91" stroke-width="42" opacity=".62"/>
              <path d="M-18 169C95 123 134 48 245 64s138 156 271 99 155-146 280-94 126 100 224 45" fill="none" stroke="#5674b0" stroke-width="8" opacity=".58"/>
              <path d="M-10 194C110 155 136 74 241 82s137 125 263 78 162-123 280-73 130 77 224 35" fill="none" stroke="#192d64" stroke-width="14" opacity=".9"/>
              <path d="M335 54c24-35 81-36 103-2 19 29-4 64-37 62-29-2-39-31-22-48 15-15 40-7 42 10" fill="none" stroke="#7390c1" stroke-width="7" opacity=".55"/>
              <path d="M607 124c27-38 86-34 103 4 14 32-13 63-45 56-28-6-34-36-15-51 17-13 41-2 40 16" fill="none" stroke="#7290c0" stroke-width="6" opacity=".58"/>
              <path d="M-10 241C170 210 249 238 383 214s213 14 351-5 183 11 276-4v65H-10Z" fill="#111c36" opacity=".9"/>
              <path d="M9 267c25-18 20-53 39-88 5 32 21 40 17 88M25 270c-7-28-17-41-31-52M45 270c12-28 23-39 39-49" fill="none" stroke="#081326" stroke-width="14" stroke-linecap="round"/>
              <g fill="url(#starry-light)">
                <circle cx="62" cy="149" r="35"/><circle cx="326" cy="40" r="28"/><circle cx="603" cy="149" r="35"/><circle cx="902" cy="43" r="30"/>
              </g>
              <g fill="#fff0bf">
                <circle cx="62" cy="149" r="4"/><circle cx="326" cy="40" r="4"/><circle cx="603" cy="149" r="4"/><circle cx="902" cy="43" r="4"/>
              </g>
            </svg>
            {testimonials.map((item, i) => (
              <button class="voice-tab" id={`voice-tab-${i}`} type="button" role="tab" aria-selected="false" aria-controls={`voice-panel-${i}`} tabindex="-1">
                <span class="paint-star" aria-hidden="true"></span>
                <span class="voice-tab-copy"><strong>{item.name}</strong><span>{item.role}</span></span>
              </button>
            ))}
          </div>
        </div>
        <div class="voice-panels">
          {testimonials.map((item, i) => (
            <figure class="quote-card" id={`voice-panel-${i}`} role="tabpanel" aria-labelledby={`voice-tab-${i}`} tabindex="0">
              <span class="quote-mark" aria-hidden="true">“</span>
              <blockquote>{item.quote}</blockquote>
              <figcaption>
                <strong>{item.name}</strong>
                <span class="quote-role">{item.role}</span>
                <span class="quote-context">{item.context}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll('[data-voices]').forEach((voices) => {
    const tabs = Array.from(voices.querySelectorAll('[role="tab"]'));
    const panels = Array.from(voices.querySelectorAll('[role="tabpanel"]'));

    const activate = (index, moveFocus = false) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[i].hidden = !selected;
      });
      if (moveFocus) tabs[index].focus();
    };

    activate(0);
    voices.classList.add('is-enhanced');

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(next, true);
      });
    });
  });
</script>

<style>
  /* Years, in the same dim mono as the date on a Writing card */
  .wk-years{font:400 12px/1.4 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}
  /* One dim line under the cards, in the site's meta text style */
  .wk-note{margin:14px 0 0}
  .wk-note a{color:var(--warm);text-underline-offset:3px}
  .wk-note a:hover{color:#fff}
  .testimonials{padding:clamp(72px,9vw,120px) 0}
  .testimonials-head{margin-bottom:clamp(28px,4vw,48px)}
  .testimonials-head .h2{margin:10px 0 0}
  .voices{display:grid;grid-template-columns:1fr;gap:24px}
  .voice-tabs{display:none}
  .voices.is-enhanced .voice-tabs{display:block}
  .starry-sky{position:relative;height:clamp(230px,25vw,300px);overflow:hidden;background:#121c3b;border:1px solid rgba(118,149,207,.25);isolation:isolate}
  .starry-sky::after{content:"";position:absolute;inset:0;z-index:0;pointer-events:none;background-image:var(--noise);background-size:180px;opacity:.16;mix-blend-mode:screen}
  .starry-paint{position:absolute;inset:0;width:100%;height:100%;z-index:-1}
  .voice-tab{position:absolute;z-index:1;display:flex;flex-direction:column;align-items:flex-start;gap:8px;width:22%;padding:8px 6px;text-align:left;color:var(--warm);background:transparent;border:0;cursor:pointer}
  .voice-tab:nth-of-type(1){left:2%;top:57%}
  .voice-tab:nth-of-type(2){left:25%;top:1%}
  .voice-tab:nth-of-type(3){left:55%;top:57%}
  .voice-tab:nth-of-type(4){left:77%;top:2%}
  .paint-star{position:relative;display:block;width:34px;height:34px;flex:none;border-radius:50%;background:radial-gradient(circle,#fff4c8 0 10%,#f5cf75 12% 20%,rgba(245,207,117,.45) 22%,transparent 72%);filter:drop-shadow(0 0 9px rgba(255,218,133,.5));transition:transform .35s,filter .35s}
  .paint-star::before,.paint-star::after{content:"";position:absolute;left:50%;top:50%;width:2px;height:34px;background:linear-gradient(transparent,rgba(255,241,197,.7),transparent);transform:translate(-50%,-50%)}
  .paint-star::after{transform:translate(-50%,-50%) rotate(90deg)}
  .voice-tab[aria-selected="true"] .paint-star{transform:scale(1.28);filter:drop-shadow(0 0 15px rgba(255,218,133,.9))}
  .voice-tab-copy{display:grid;gap:4px;min-width:0}
  .voice-tab-copy strong{font-size:13px;line-height:1.3;color:#fff1ca;text-shadow:0 1px 8px #111a35}
  .voice-tab-copy span{font-size:10px;line-height:1.4;color:#c0cde2;text-shadow:0 1px 8px #111a35}
  .voice-tab[aria-selected="true"] .voice-tab-copy strong{color:#fff}
  .voice-tab:focus-visible{outline:2px solid #f5cf75;outline-offset:3px}
  .voice-panels{min-width:0}
  .quote-card{position:relative;min-height:100%;margin:0;padding:clamp(26px,4vw,52px);border:1px solid rgba(118,149,207,.25);background:
    radial-gradient(ellipse at 85% 0%,rgba(50,76,140,.24),transparent 58%),
    linear-gradient(145deg,rgba(31,52,103,.44),transparent 52%),#11172c;
    display:flex;flex-direction:column;align-items:flex-start;overflow:hidden}
  .quote-card::after{content:"";position:absolute;right:-60px;top:-100px;width:320px;height:220px;border:1px solid rgba(124,153,207,.16);border-radius:50%;transform:rotate(-18deg);pointer-events:none}
  .quote-card[hidden]{display:none}
  .quote-mark{height:52px;margin:-15px 0 4px;font:400 92px/.9 var(--disp);color:#f5cf75;opacity:.9}
  .quote-card blockquote{position:relative;z-index:1;margin:0 0 32px;font:400 clamp(21px,2.4vw,31px)/1.4 var(--disp);color:#f3f0e7;white-space:pre-line}
  .quote-card figcaption{position:relative;z-index:1;display:grid;gap:5px;margin-top:auto;padding-top:18px;border-top:1px solid rgba(118,149,207,.25);width:100%}
  .quote-card figcaption strong{font-size:15px;color:#fff1ca}
  .quote-role{font-size:13px;line-height:1.5;color:#d0d8e6}
  .quote-context{margin-top:7px;font-size:13px;line-height:1.6;color:#aab6cd}
  .voices.is-enhanced .quote-card:not([hidden]){animation:voice-arrive .38s ease both}
  @keyframes voice-arrive{from{opacity:.35;transform:translateY(7px)}to{opacity:1;transform:none}}
  @media(max-width:700px){
    .voices{gap:16px}
    .starry-sky{height:220px}
    .voice-tab{top:38%!important;left:calc(var(--i,0) * 25%)!important;width:25%;align-items:center;text-align:center;padding:5px 2px;gap:5px}
    .voice-tab:nth-of-type(1){left:0!important}
    .voice-tab:nth-of-type(2){left:25%!important}
    .voice-tab:nth-of-type(3){left:50%!important}
    .voice-tab:nth-of-type(4){left:75%!important}
    .paint-star{width:27px;height:27px}
    .paint-star::before{height:27px}
    .paint-star::after{width:27px}
    .voice-tab-copy strong{font-size:10px;overflow-wrap:anywhere}
    .voice-tab-copy span{display:none}
    .quote-card{padding:24px}
  }
  @media(prefers-reduced-motion:reduce){.paint-star,.voices.is-enhanced .quote-card:not([hidden]){transition:none;animation:none}}
</style>
