---
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const onWriting = path === '/writing' || path.startsWith('/writing/');
const onPress = path === '/press';
const onWork = path === '/work' || path.startsWith('/work/');
const onProjects = path === '/projects' || path.startsWith('/projects/');
---
<header class="enav">
  <div class="enav-bar">
    <a class="enav-logo" href="/" aria-label="Roald van Buuren, home"><Logo /><span class="enav-name">Roald van Buuren</span></a>
    <nav class="enav-right" aria-label="Main">
      <a class="enav-link" href="/writing" aria-current={onWriting ? 'page' : undefined}>Journal</a>
      <a class="enav-link" href="/press" aria-current={onPress ? 'page' : undefined}>Press</a>
      <a class="enav-link" href="/work" aria-current={onWork ? 'page' : undefined}>Work</a>
      <a class="enav-link" href="/projects" aria-current={onProjects ? 'page' : undefined}>Side projects</a>
    </nav>
  </div>
</header>

<style>
  /* Four links now sit in the bar: tighten the small-screen spacing so it still fits at 375px. */
  @media (max-width:560px){
    .enav-bar{gap:12px}
    .enav-logo{font-size:17px;white-space:nowrap}
    .enav-name{display:none}
    .rvb-mark{height:26px}
    .enav-right{gap:14px}
    .enav-link{font-size:11px;letter-spacing:.08em}
  }
</style>
