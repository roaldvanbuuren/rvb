---
// Occasional life in the hero sky: a falling star, a plane, a flock of birds.
// Random, rare, silent. Off for visitors who prefer reduced motion.
---
<div class="sky" aria-hidden="true"></div>

<script>
  const sky = document.querySelector<HTMLElement>('.sky');

  if (sky) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const rnd = (a: number, b: number) => a + Math.random() * (b - a);
    const pick = <T,>(xs: T[]) => xs[Math.floor(Math.random() * xs.length)];
    const W = () => sky.clientWidth;
    const H = () => sky.clientHeight;
    // Keep everything in the open sky, clear of the nav bar and the mountains.
    const yMin = () => Math.max(84, H() * 0.12);
    const yMax = () => H() * 0.42;

    let timer: number | undefined;
    let heroVisible = true;
    let planeUp = false;

    const el = (cls: string, html = '') => {
      const d = document.createElement('div');
      d.className = 'sky-el ' + cls;
      if (html) d.innerHTML = html;
      sky.appendChild(d);
      return d;
    };
    const done = (node: HTMLElement) => (a: Animation) => {
      a.onfinish = () => node.remove();
    };

    function fallingStar() {
      const len = rnd(90, 150);
      const theta = rnd(16, 30);
      const phi = Math.random() < 0.5 ? theta : 180 - theta; // down-right or down-left
      const rad = (phi * Math.PI) / 180;
      const dist = rnd(280, 420);
      const s = el('sky-star');
      s.style.width = len + 'px';
      s.style.left = rnd(W() * 0.15, W() * 0.85) + 'px';
      s.style.top = rnd(yMin(), (yMin() + yMax()) / 2) + 'px';
      const rot = `rotate(${phi}deg)`;
      done(s)(
        s.animate(
          [
            { transform: `translate(0,0) ${rot}`, opacity: 0 },
            { opacity: 0.95, offset: 0.18 },
            { transform: `translate(${Math.cos(rad) * dist}px,${Math.sin(rad) * dist}px) ${rot}`, opacity: 0 },
          ],
          { duration: rnd(800, 1200), easing: 'cubic-bezier(.3,.1,.5,1)', fill: 'forwards' }
        )
      );
    }

    function birds() {
      const n = Math.floor(rnd(3, 7));
      const dir = Math.random() < 0.5 ? 1 : -1;
      const flock = el('sky-flock');
      const y0 = rnd(yMin(), yMax());
      for (let i = 0; i < n; i++) {
        const b = document.createElement('span');
        b.className = 'sky-bird';
        const w = rnd(13, 22);
        b.style.width = w + 'px';
        b.style.left = -i * rnd(16, 28) * dir + 'px';
        b.style.top = (i % 2 ? 1 : -1) * i * rnd(3, 8) + 'px';
        b.style.setProperty('--flap', rnd(0.45, 0.75).toFixed(2) + 's');
        b.style.animationDelay = '-' + rnd(0, 0.7).toFixed(2) + 's';
        b.innerHTML = '<svg viewBox="0 0 20 8" aria-hidden="true"><path d="M1 6.5 Q5.5 0.5 10 5 Q14.5 0.5 19 6.5"/></svg>';
        flock.appendChild(b);
      }
      const from = dir === 1 ? -80 : W() + 80;
      const to = dir === 1 ? W() + 120 : -120;
      const drift = rnd(-24, 12);
      flock.style.top = y0 + 'px';
      done(flock)(
        flock.animate(
          [
            { transform: `translate(${from}px,0)` },
            { transform: `translate(${to}px,${drift}px)` },
          ],
          { duration: rnd(17000, 26000), easing: 'linear', fill: 'forwards' }
        )
      );
    }

    function plane() {
      if (planeUp) return;
      planeUp = true;
      const dir = Math.random() < 0.5 ? 1 : -1;
      const wrap = el('sky-plane');
      wrap.style.top = rnd(yMin(), H() * 0.3) + 'px';
      wrap.innerHTML =
        '<div class="sky-plane-in" style="transform:scaleX(' + dir + ')">' +
        '<i class="sky-trail"></i>' +
        '<svg viewBox="0 0 40 14" aria-hidden="true">' +
        '<path d="M6 8 Q6 6.2 9 6.2 L34 6.2 Q39 6.4 39.6 7.6 Q39 8.8 34 9 L9 9 Q6 9 6 8 Z"/>' +
        '<path d="M6.6 6.6 L3 1.4 L7.2 1.4 L11.4 6.4 Z"/>' +
        '<path d="M15.5 8.8 L26 8.8 L20.2 12.8 L16.6 12.8 Z"/>' +
        '</svg></div>';
      const from = dir === 1 ? -260 : W() + 260;
      const to = dir === 1 ? W() + 120 : -120;
      const a = wrap.animate(
        [
          { transform: `translate(${from}px,0)`, opacity: 0 },
          { opacity: 1, offset: 0.06 },
          { opacity: 1, offset: 0.94 },
          { transform: `translate(${to}px,${-rnd(6, 16)}px)`, opacity: 0 },
        ],
        { duration: rnd(30000, 44000), easing: 'linear', fill: 'forwards' }
      );
      a.onfinish = () => {
        wrap.remove();
        planeUp = false;
      };
    }

    const kinds: Record<string, () => void> = { star: fallingStar, birds, plane };
    const weighted = ['star', 'star', 'star', 'birds', 'birds', 'plane'];

    function schedule(first = false) {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (heroVisible && !document.hidden && !reduce.matches) kinds[pick(weighted)]();
        schedule();
      }, first ? rnd(2500, 4000) : rnd(7000, 16000));
    }

    function start() {
      if (!reduce.matches) schedule(true);
    }
    function stop() {
      window.clearTimeout(timer);
      sky.replaceChildren();
      planeUp = false;
    }

    new IntersectionObserver((entries) => {
      heroVisible = entries[0].isIntersecting;
    }).observe(sky);
    reduce.addEventListener('change', () => (reduce.matches ? stop() : start()));
    // Manual trigger, e.g. sky.dispatchEvent(new CustomEvent('sky:spawn', { detail: 'star' }))
    sky.addEventListener('sky:spawn', (e) => {
      const k = (e as CustomEvent<string>).detail;
      if (!reduce.matches && kinds[k]) kinds[k]();
    });
    start();
  }
</script>
