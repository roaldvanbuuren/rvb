---
// The About portrait: the family clover with the photo living inside the accent leaf (blue duotone).
// Same geometry as Logo.astro (four hearts, tips to the centre); the three plain leaves use the light-panel ink.
// roald-clover.jpg is the photo pre-toned as accent x grayscale, so no blend modes are needed at runtime.
---
<svg class="clover-portrait" viewBox="16.7 9.2 66.6 77.7" role="img" aria-label="Portrait of Roald van Buuren, set inside a four-leaf clover">
  <defs>
    <clipPath id="clover-leaf">
      <path transform="translate(50 42) rotate(45) translate(0 -2.2)" d="M0 0 L-14 -14 A9.899 9.899 0 0 1 0 -28 A9.899 9.899 0 0 1 14 -14 Z" />
    </clipPath>
  </defs>
  <path d="M50 60.20 C50 72.80 50 72.80 57.70 84.00" fill="none" stroke="var(--l-ink, #141414)" stroke-width="4.76" />
  <g fill="var(--l-ink, #141414)">
    <g transform="translate(50 42) rotate(135) translate(0 -2.2)"><path d="M0 0 L-14 -14 A9.899 9.899 0 0 1 0 -28 A9.899 9.899 0 0 1 14 -14 Z" /></g>
    <g transform="translate(50 42) rotate(225) translate(0 -2.2)"><path d="M0 0 L-14 -14 A9.899 9.899 0 0 1 0 -28 A9.899 9.899 0 0 1 14 -14 Z" /></g>
    <g transform="translate(50 42) rotate(315) translate(0 -2.2)"><path d="M0 0 L-14 -14 A9.899 9.899 0 0 1 0 -28 A9.899 9.899 0 0 1 14 -14 Z" /></g>
  </g>
  <g clip-path="url(#clover-leaf)">
    <rect x="48" y="8" width="36" height="36" fill="#5565F0" />
    <image href="/images/roald-clover.jpg" x="45.6" y="10.7" width="40" height="40" preserveAspectRatio="xMidYMid slice" />
  </g>
</svg>
