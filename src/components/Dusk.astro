---
// Hero dusk: the sky deepens to indigo as the page scrolls, the rose light goes out
// and stars come in. All of it reads one
// number, --dusk (0 at the top of the page, 1 at full dusk), set by a CSS scroll-driven
// animation on .hero (see global.css). The script below only runs where
// animation-timeline is not supported.

// Stars: a night sky that turns. About 130 tiny stars sit on a disc around a pole at the bottom centre of the star
// window (the top 45% of the hero image box, never the mountains). The disc turns once every 800s, so stars drift in
// slow arcs and new ones rise into the window as others leave; about 25 are in view on a desktop. Positions are fixed
// at build with a seeded PRNG, in units of the disc radius (em, with font-size set to that radius in CSS).
// Stars are box-shadows on 8 tiny groups, and each group twinkles on its own 6 to 10 s cycle, so the whole sky is
// 8 elements and every star twinkles, out of phase.
function mulberry32(seed: number) {
  let a = seed;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(20261106);
const between = (a: number, b: number) => a + rnd() * (b - a);

const GROUPS = 8;
const COUNT = 130;
const hex = (n: number) => Math.round(Math.min(1, Math.max(0, n)) * 255).toString(16).padStart(2, '0');
const shadows: string[][] = Array.from({ length: GROUPS }, () => []);
const placed: { u: number; v: number }[] = [];
for (let guard = 0; placed.length < COUNT && guard < 50000; guard++) {
  const r = Math.sqrt(rnd()); // uniform over the disc's area
  const t = rnd() * Math.PI * 2;
  const u = r * Math.cos(t);
  const v = r * Math.sin(t);
  if (placed.some((p) => Math.hypot(p.u - u, p.v - v) < 0.065)) continue; // scattered, not clumped
  const big = rnd() < 0.2; // a few slightly brighter and bigger (about 2.5px, the rest about 1.6px; the turn smears 1px dots)
  const alpha = big ? between(0.9, 1) : between(0.7, 0.92);
  shadows[placed.length % GROUPS].push(`${u.toFixed(3)}em ${v.toFixed(3)}em 0 ${big ? '.8px' : '.3px'} #f5f6f2${hex(alpha)}`);
  placed.push({ u, v });
}
const groups = shadows.map((list) => ({
  shadow: list.join(','),
  d: Math.round(between(6, 10) * 10) / 10, // twinkle cycle, seconds
  dl: -Math.round(between(0, 10) * 10) / 10, // negative delay: out of phase from the first frame
  lo: Math.round(between(0.25, 0.45) * 100) / 100, // how far it dips
}));
---
<div class="dusk" aria-hidden="true"></div>
<div class="dusk-glow" aria-hidden="true"></div>
<div class="stars" aria-hidden="true">
  <div class="sk">
    {groups.map((g) => (
      <i class="sg" style={`box-shadow:${g.shadow};--d:${g.d}s;--dl:${g.dl}s;--lo:${g.lo}`}></i>
    ))}
  </div>
</div>

<script>
  // Fallback for browsers without scroll-driven animations (animation-timeline).
  // Mirrors the CSS: --dusk eases (CSS `ease`) from 0 to 1 as the hero scrolls from its top edge at the
  // top of the viewport to half out of view. Static when the visitor prefers reduced motion.
  const hero = document.querySelector<HTMLElement>('.hero');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && !CSS.supports('animation-timeline', 'view()')) {
    // CSS `ease`, cubic-bezier(.25,.1,.25,1), so the fallback matches the native animation
    const ease = (x: number) => {
      const b = (a: number, c: number, t: number) => 3 * a * (1 - t) * (1 - t) * t + 3 * c * (1 - t) * t * t + t * t * t;
      let lo = 0;
      let hi = 1;
      for (let i = 0; i < 24; i++) {
        const mid = (lo + hi) / 2;
        if (b(0.25, 0.25, mid) < x) lo = mid;
        else hi = mid;
      }
      return b(0.1, 1, (lo + hi) / 2);
    };
    let frame = 0;
    const update = () => {
      frame = 0;
      const r = hero.getBoundingClientRect();
      const t = Math.min(1, Math.max(0, -r.top / (r.height * 0.5)));
      hero.style.setProperty('--dusk', ease(t).toFixed(4));
      hero.style.setProperty('--par', Math.min(1, Math.max(0, -r.top / r.height)).toFixed(4)); // sky drifts at half speed
    };
    const queue = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const start = () => {
      window.addEventListener('scroll', queue, { passive: true });
      window.addEventListener('resize', queue);
      update();
    };
    const stop = () => {
      window.removeEventListener('scroll', queue);
      window.removeEventListener('resize', queue);
      hero.style.removeProperty('--dusk');
      hero.style.removeProperty('--par');
    };
    if (!reduce.matches) start();
    reduce.addEventListener('change', () => (reduce.matches ? stop() : start()));
  }
</script>
