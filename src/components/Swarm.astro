          tx = sx[i] * A * 1.05 + 0.06 * Math.sin(tm * 0.08 + ph[i]); ty = sy[i] * 1.05 + 0.06 * Math.cos(tm * 0.07 + sx[i] * 2);
          ta = 0.06 * br[i]; ts = 2; th = 0.4; return 0.8;
        }
        case 24: {
          // side projects: one small community per project, side by side
          const w = hx1 - hx0, hh = hy1 - hy0, n = nProj, k = i % (n + 1);
          if (k < n) {
            const cx = hx0 + w * ((k + 0.5) / n), cy = hy0 + hh * 0.5, r = Math.min(hh * 0.28, (w / n) * 0.26);
            const rot = tm * (0.12 + 0.2 * s) * (k % 2 ? 1 : -1), c = Math.cos(rot), sn = Math.sin(rot), ox = gx[i] * r * 0.5, oy = gy[i] * r * 0.5;
            tx = cx + ox * c - oy * sn; ty = cy + ox * sn + oy * c; tz = 0;
            ta = (0.24 + 0.18 * br[i]); ts = 2.3; th = 0.55 + 0.25 * s; return 1.2;
          }
          tx = sx[i] * A * 1.05 + 0.06 * Math.sin(tm * 0.08 + ph[i]); ty = sy[i] * 1.05 + 0.06 * Math.cos(tm * 0.07 + sx[i] * 2);
          ta = 0.06 * br[i]; ts = 2; th = 0.4; return 0.8;
        }
        case 25: {
          // lost: the dots drift without a shape, a few of them searching quickly
          const fast = i % 23 === 0, sp2 = fast ? 0.6 : 0.12;
          tx = sx[i] * A * 1.02 + 0.3 * Math.sin(tm * sp2 * br[i] + ph[i]); ty = sy[i] * 1.02 + 0.3 * Math.cos(tm * sp2 * 0.8 * br[i] + ph[i] * 1.3); tz = z0[i] * 0.6;
          ta = (fast ? 0.55 : 0.24) * br[i] * (0.6 + 0.4 * Math.sin(tm * 0.7 + ph[i])); ts = fast ? 2.8 : 2.2; th = fast ? 0.5 : 0.12 + 0.2 * s; return fast ? 2 : 0.6;
        }
        case 30: case 31: {
          // the quiet field under every header (an article's body: still and nearly gone)
          tx = sx[i] * A * 1.05 + 0.08 * Math.sin(tm * 0.06 + sy[i] * 2 + ph[i]); ty = sy[i] * 1.05 + 0.08 * Math.cos(tm * 0.05 + sx[i] * 2);
          tz = 0; ta = (a === 31 ? 0 : 0.07) * br[i]; ts = 2; th = 0.3 + 0.25 * s; return 0.8;
        }
        default: {
          tx = (rankH[i] * 2 - 1) * A * 1.08;
          ty = (wide ? -0.4 : -0.3) + 0.012 * Math.sin(tx * 5 + tm * 0.6) + gy[i] * 0.0035;
          tz = 0; const fall = 1 - Math.abs(tx) / (A * 1.08);
          ta = (0.14 + 0.7 * fall * fall) * br[i]; ts = 2.2 + fall * 1.4; th = 0.6 + 0.16 * s; return 1;
        }
      }
    }

    const DIM: Record<number, number> = {};
    function step(dt: number, snap = false) {
      time += dt;
      const tm = time;
      const sg = stage(act), sk = snap ? 1 : Math.min(1, dt * 2.2);
      scx += (sg[0] - scx) * sk; scy += (sg[1] - scy) * sk; sR += (sg[2] - sR) * sk;
      const P = act === 1 ? sstep(0.34, 0.64, t) : 0;
      const G = act === 5 ? 0.05 + 0.95 * sstep(0.32, 0.66, t) : 0;
      if (act === 1) { const p = playerTarget(P, tm); prX = p[0]; prY = p[1]; }
      const net = act === 2;
      if (net) placeHubs(act, tm, lt());
      const cursor = mOn && !snap ? (act === 5 ? 1 : act === 4 ? 0.15 : 0.45) : 0, rad = act === 5 ? 0.32 : 0.22, r2 = rad * rad;
      const flowAmt = act === 5 ? 0.55 : act === 0 || act === 11 ? 0.08 : act === 3 ? 0.25 : 0.12;
      const dec = snap ? 1 : Math.min(1, dt * 2.6);
      gDim += ((DIM[act] ?? 1) * (!HOME && !wide && act < 30 ? 0.7 : 1) - gDim) * dec;
      let fr = 0;
      for (let i = 0; i < N; i++) {
        const km = target(i, act, tm, P, G);
        if (snap || wrap) { px[i] = tx; py[i] = ty; vx[i] = 0; vy[i] = 0; if (wrap) ca[i] = 0; }
        else if (km === 0) { // the player: tight follow
          const f = Math.min(1, dt * 14); px[i] += (tx - px[i]) * f; py[i] += (ty - py[i]) * f; vx[i] = 0; vy[i] = 0;
        } else {
          const k = Math.min(8, stiff[i] * km), k2 = k * k, damp = 2 * k * 0.82;
          let ax = (tx - px[i]) * k2 - vx[i] * damp, ay = (ty - py[i]) * k2 - vy[i] * damp;
          const X = px[i], Y = py[i];
          ax += (Math.sin(1.7 * Y + tm * 0.09 + ph[i] * 0.2) + 0.5 * Math.sin(3.1 * Y + 1.3 * X + tm * 0.07)) * flowAmt;
          ay += (Math.cos(1.3 * X - tm * 0.11) + 0.5 * Math.cos(2.7 * X - 1.9 * Y + tm * 0.05)) * flowAmt;
          if (cursor) {
            const dx = X - mx, dy = Y - my, d2 = dx * dx + dy * dy;
            if (d2 < r2) {
              const d = Math.sqrt(d2) + 1e-4, f = 1 - d / rad, s = 0.3 + sens[i];
              ax += (dx / d) * f * 9 * s * cursor; ay += (dy / d) * f * 9 * s * cursor;
              hT[i] = Math.min(1, hT[i] + f * dt * 3.2 * s * cursor);
            }
          }
          vx[i] += ax * dt; vy[i] += ay * dt;
          px[i] += vx[i] * dt; py[i] += vy[i] * dt;
        }
        if (snap) { pz[i] = tz; ca[i] = ta; ch[i] = th; cs[i] = ts; hT[i] = 0; }
        else {
          pz[i] += (tz - pz[i]) * dec; hT[i] = Math.max(0, hT[i] - dt * 0.55);
          ca[i] += (ta - ca[i]) * dec; ch[i] += (th - ch[i]) * dec; cs[i] += (ts - cs[i]) * dec;
        }
        const h = Math.min(1, ch[i] + hT[i]);
        if (h > 0.62) fr++;
        writeAgent(i, h);
      }
      fractured = fr;
      // pressure waves through the clover now and then
      if (!snap && act === 0) {
        if (tm - waveT > 4.2) { waveT = tm; waveX = (rnd() * 1.2 - 0.6) * Math.min(1, A); waveY = rnd() * 1.2 - 0.6; }
        const wr = (tm - waveT) * 0.55, wf = Math.max(0, 1 - (tm - waveT) / 3.6);
        if (wf > 0) for (let i = 0; i < N; i++) {
          const dx = px[i] - waveX, dy = py[i] - waveY, d = Math.sqrt(dx * dx + dy * dy), e = (d - wr) / 0.05;
          if (e > -1.5 && e < 1.5) { hT[i] = Math.min(1, hT[i] + Math.exp(-e * e) * dt * 2.4 * wf * (0.25 + sens[i])); writeAgent(i, Math.min(1, ch[i] + hT[i])); }
        }
      }
      // the player's trail
      trailA += ((act === 1 ? 1 : 0) - trailA) * (snap ? 1 : Math.min(1, dt * 3));
      if (act === 1) { trX[trHead] = px[0]; trY[trHead] = py[0]; trH[trHead] = ch[0]; trHead = (trHead + 1) % TRAIL; }
      writeTrail(snap);
      // the network: hubs, messages, links
      netA += ((act === 2 ? 1 : 0) - netA) * (snap ? 1 : Math.min(1, dt * 2));
      writeNetwork(tm);
      lines(dt, snap);
      if (PAINT) paintStep(dt, snap, tm, P, G);
    }

    function writeAgent(i: number, h: number) {
      const o3 = i * 3, o4 = i * 4;
      pos[o3] = px[i]; pos[o3 + 1] = py[i]; pos[o3 + 2] = pz[i];
      heatRGB(h, col, o4, 1);
      if (PAINT) { // no two strokes the same mix: lighter or darker, and a few blues pulled toward viridian
        const m = 0.78 + 0.4 * br[i] * (0.5 + 0.5 * Math.sin(ph[i] * 7));
        col[o4] *= m; col[o4 + 1] *= m; col[o4 + 2] *= m;
        if (i % 7 === 3 && h < 0.5) { col[o4] = col[o4] * 0.7 + 0.08; col[o4 + 1] = col[o4 + 1] * 0.7 + 0.2; col[o4 + 2] = col[o4 + 2] * 0.7 + 0.1; }
      }
      col[o4 + 3] = PAINT ? Math.min(0.92, ca[i] * (act >= 7 ? 0.36 : act === 0 ? 1.25 : 0.9) * gDim * (1 + hT[i] * 0.8)) : Math.min(1.6, ca[i] * 1.5 * gDim * (1 + hT[i] * 0.8));
      size[i] = cs[i] * 1.45 * (1 + hT[i] * 0.5);
    }
    function writeTrail(snap: boolean) {
      for (let k = 0; k < TRAIL; k++) {
        const idx = (trHead - 1 - k + TRAIL * 2) % TRAIL, j = oTrail + k, o3 = j * 3, o4 = j * 4, age = k / TRAIL;
        pos[o3] = trX[idx]; pos[o3 + 1] = trY[idx]; pos[o3 + 2] = 0;
        heatRGB(trH[idx], col, o4, 1);
        col[o4 + 3] = snap ? 0 : trailA * (1 - age) * (1 - age) * 0.55;
        size[j] = 5 * (1 - age * 0.6);
      }
    }
    function writeNetwork(tm: number) {
      const on = netA > 0.01;
      // hubs
      for (let h = 0; h < HUBS; h++) {
        const j = oHub + h, o3 = j * 3, o4 = j * 4, k = h >> 2, main = (h & 3) === 0;
        pos[o3] = hubX[h]; pos[o3 + 1] = hubY[h]; pos[o3 + 2] = 0;
        heatRGB(0.36 + crisis[k] * 0.55, col, o4, 1);
        col[o4 + 3] = on ? netA * (main ? 1.1 : 0.7) : 0; size[j] = main ? 14 : 8;
      }
      // messages: a member posts, the message travels to its hub
      for (let m = 0; m < MSG; m++) {
        const j = oMsg + m, o3 = j * 3, o4 = j * 4;
        const cyc = tm * 0.55 + m * 0.6180339, f = fract(cyc), who = (Math.floor(cyc) * 104729 + m * 7919) % N;
        const hb = comm[who] * 4 + hubOf[who];
        pos[o3] = px[who] + (hubX[hb] - px[who]) * f; pos[o3 + 1] = py[who] + (hubY[hb] - py[who]) * f; pos[o3 + 2] = 0;
        heatRGB(0.42 + crisis[comm[who]] * 0.5, col, o4, 1);
        col[o4 + 3] = on ? netA * Math.sin(Math.PI * f) * 0.9 : 0; size[j] = 4.5;
      }
      if (!on) return;
      // links
      let l = 0;
      const put = (x0: number, y0: number, x1: number, y1: number, h: number, a: number) => {
        const o = l * 4, c = l * 8;
        lpos[o] = x0; lpos[o + 1] = y0; lpos[o + 2] = x1; lpos[o + 3] = y1;
        heatRGB(h, lcol, c, 1); lcol[c + 3] = a; lcol[c + 4] = lcol[c]; lcol[c + 5] = lcol[c + 1]; lcol[c + 6] = lcol[c + 2]; lcol[c + 7] = a * 0.35;
        l++;
      };
      for (const i of linkMembers) { const k = comm[i], hb = k * 4 + hubOf[i]; put(hubX[hb], hubY[hb], px[i], py[i], 0.38 + crisis[k] * 0.5, 0.16 * netA * ca[i] * 2.4); }
      for (let k = 0; k < 4; k++) for (let h = 1; h < 4; h++) put(hubX[k * 4], hubY[k * 4], hubX[k * 4 + h], hubY[k * 4 + h], 0.4 + crisis[k] * 0.5, 0.4 * netA);
      if (act === 2) for (const [a, b] of bridges) put(hubX[a * 4], hubY[a * 4], hubX[b * 4], hubY[b * 4], 0.42 + Math.max(crisis[a], crisis[b]) * 0.45, 0.3 * netA);
      lineCount = l;
    }
    let lineCount = 0;

    // ---------- the page's amber lines, formed by dots from the swarm ----------
    // CSS still sizes and times every line (hover stretches it); its paint is hidden. Each frame a line asks for one dot
    // per pixel of its current length. A dot that is newly wanted leaves a swarm agent near it, flies in and locks on;
    // a dot no longer wanted lets go and drifts back into the swarm. Off screen, nothing flies.
    const lx = new Float32Array(LC), ly = new Float32Array(LC), lvx = new Float32Array(LC), lvy = new Float32Array(LC);
    const la = new Float32Array(LC), lst = new Uint8Array(LC), lfrom = new Uint32Array(LC); // state: 0 idle, 1 coming, 2 locked, 3 leaving
    const LINE_A = 0.42, LINE_H = 0.72;
    // how visible an element really is: its own and every ancestor's opacity (reveals, the road's fade-ins)
    function seen(el: HTMLElement) {
      let o = 1, n: HTMLElement | null = el;
      for (let d = 0; n && d < 8 && n.tagName !== 'MAIN'; d++, n = n.parentElement) { o *= Number(getComputedStyle(n).opacity); if (o < 0.01) return 0; }
      return o;
    }
    // the lines draw on their own 2D layer above the page, so a line on a card or a photo is never hidden behind it
    const top = document.querySelector<HTMLCanvasElement>('.t-top'), tctx = top?.getContext('2d') ?? null;
    let tdpr = 1;
    function topLayout() { if (!top) return; tdpr = Math.min(devicePixelRatio || 1, 2); top.width = Math.round(W * tdpr); top.height = Math.round(H * tdpr); }
    const sxp = (x: number) => (x / A + 1) * 0.5 * W, syp = (y: number) => (1 - y) * 0.5 * H;
    function clearBlock(k: number) { for (let q = 0; q < B; q++) { const j = k * B + q; lst[j] = 0; la[j] = 0; } }
    function lines(dt: number, snap: boolean) {
      if (!tctx || !top) return;
      tctx.setTransform(tdpr, 0, 0, tdpr, 0, 0);
      tctx.clearRect(0, 0, W, H);
      tctx.globalCompositeOperation = 'lighter';
      const px1 = 2 / H, sp = SP * px1, lock = 1.6 * px1;
      const fdec = snap ? 1 : Math.min(1, dt * 7), k = 24, k2 = k * k, damp = 2 * k * 0.9;
      for (const g of lineSrc) {
        const r = g.el.getBoundingClientRect(), vis = r.bottom > -40 && r.top < innerHeight + 40 && r.width > 0;
        if (!vis) { if (g.blk >= 0) { clearBlock(g.blk); freeB.push(g.blk); g.blk = -1; } continue; }
        if (g.blk < 0) { if (!freeB.length) continue; g.blk = freeB.pop()!; clearBlock(g.blk); }
        let lx0 = r.left, w = r.width, yy = r.top + r.height / 2, pop = 1;
        if (g.pseudo) {
          const cs = getComputedStyle(g.el, '::after');
          w = parseFloat(cs.width) || 0; lx0 = r.left + (parseFloat(cs.left) || 0); yy = r.bottom - (parseFloat(cs.bottom) || 0) - 1; pop = Number(cs.opacity);
        }
        const op = w > 0.5 && pop > 0.01 ? pop * seen(g.el) : 0;
        const x0 = wx(lx0), len = Math.min(w, B * SP), y = wy(yy), at = g.blk * B;
        let solid = 0, run = true, solA = 0;
        for (let q = 0; q < B; q++) {
          const j = at + q;
          const want = op > 0.02 && (q + 0.5) * SP <= len;
          if (!want && lst[j] === 0) { if ((q + 0.5) * SP > len + 40) break; run = false; continue; }
          const sx0 = x0 + (q + 0.5) * sp, sy0 = y;
          if (want) {
            if (snap) { lst[j] = 2; la[j] = op; }
            if (lst[j] === 0 || lst[j] === 3) {
              if (lst[j] === 0) { // leave from a swarm agent, the nearest of three picked at random
                let best = 0, bd = 1e9;
                for (let t2 = 0; t2 < 3; t2++) { const a = (Math.random() * N) | 0, d = (px[a] - sx0) ** 2 + (py[a] - sy0) ** 2; if (d < bd) { bd = d; best = a; } }
                lfrom[j] = best; lx[j] = px[best]; ly[j] = py[best]; lvx[j] = 0; lvy[j] = 0;
              }
              lst[j] = 1;
            }
            if (lst[j] === 1) {
              lvx[j] += ((sx0 - lx[j]) * k2 - lvx[j] * damp) * dt; lvy[j] += ((sy0 - ly[j]) * k2 - lvy[j] * damp) * dt;
              lx[j] += lvx[j] * dt; ly[j] += lvy[j] * dt;
              if (Math.abs(sx0 - lx[j]) < lock && Math.abs(sy0 - ly[j]) < lock) lst[j] = 2;
            }
            if (lst[j] === 2) { lx[j] = sx0; ly[j] = sy0; }
            la[j] += (op - la[j]) * fdec;
          } else if (lst[j] === 1 || lst[j] === 2 || lst[j] === 3) {
            // let go: drift back toward the agent it came from, fading
            const a = lfrom[j];
            lst[j] = 3; lx[j] += (px[a] - lx[j]) * Math.min(1, dt * 2.5); ly[j] += (py[a] - ly[j]) * Math.min(1, dt * 2.5);
            la[j] *= snap ? 0 : Math.max(0, 1 - dt * 4);
            if (la[j] < 0.01) { lst[j] = 0; la[j] = 0; }
          }
          if (lst[j] === 2 && run) { solid = q + 1; solA = la[j]; continue; } // part of the formed line: drawn whole below
          run = false;
          if (la[j] < 0.01) continue;
          // a dot on its way in or out
          const X = sxp(lx[j]), Y = syp(ly[j]);
          tctx.fillStyle = `rgba(250,196,110,${Math.min(1, la[j] * 0.9).toFixed(3)})`;
          tctx.fillRect(X - 0.9, Y - 0.9, 1.8, 1.8);
        }
        if (solid) {
          // the formed part, dot by dot but packed into the original line: 2px, amber, with its glow
          const X0 = sxp(x0), Y0 = syp(y), L = solid * SP;
          tctx.shadowColor = `rgba(232,163,61,${(0.6 * solA).toFixed(3)})`; tctx.shadowBlur = 14;
          tctx.fillStyle = `rgba(232,163,61,${solA.toFixed(3)})`;
          tctx.fillRect(X0, Y0 - 1, L, 2);
          tctx.shadowBlur = 0;
          tctx.fillStyle = `rgba(255,214,150,${(0.22 * solA).toFixed(3)})`; // the dots it is made of, a shade lighter
          for (let q = 0; q < solid; q += 3) tctx.fillRect(X0 + q * SP, Y0 - 1, 1, 2);
        }
      }
    }

    function draw() {
      if (!gl || !prog || !lprog) return;
      if (PAINT && sprog) return drawPaint();
      gl.clear(gl.COLOR_BUFFER_BIT);
      if (netA > 0.01 && lineCount) {
        gl.useProgram(lprog); gl.bindVertexArray(vaoL);
        gl.bindBuffer(gl.ARRAY_BUFFER, bLPos); gl.bufferSubData(gl.ARRAY_BUFFER, 0, lpos);
        gl.bindBuffer(gl.ARRAY_BUFFER, bLCol); gl.bufferSubData(gl.ARRAY_BUFFER, 0, lcol);
        gl.drawArrays(gl.LINES, 0, lineCount * 2);
      }
      gl.useProgram(prog); gl.bindVertexArray(vaoP);
      gl.bindBuffer(gl.ARRAY_BUFFER, bPos); gl.bufferSubData(gl.ARRAY_BUFFER, 0, pos);
      gl.bindBuffer(gl.ARRAY_BUFFER, bCol); gl.bufferSubData(gl.ARRAY_BUFFER, 0, col);
      gl.bindBuffer(gl.ARRAY_BUFFER, bSize); gl.bufferSubData(gl.ARRAY_BUFFER, 0, size);
      gl.drawArrays(gl.POINTS, 0, M);
    }

    const fmt = (n: number) => Math.round(n).toLocaleString('en-GB');
    function hud() {
      if (!hudA || !hudB) return;
      let a = '', b = '';
      if (act === 1) {
        const P = sstep(0.34, 0.64, t);
        a = P < 0.5 ? 'Score 12–3 · Economy full' : 'Score 11–12 · Economy broken';
        b = 'Pressure ' + P.toFixed(2);
      } else if (act === 2) {
        const reached = crisis.reduce((n, c) => n + (c > 0.5 ? 1 : 0), 0);
        a = 'Servers 4 · Members ' + fmt(N); b = reached ? 'Crisis reached ' + reached + ' / 4' : 'Messages flowing';
      } else if (act === 3) { a = 'Communities ' + C; b = 'Agents ' + fmt(N); }
      else if (act === 4) { a = 'Recording'; b = 'Rows ' + fmt(Math.min(1, lt() * 1.02) * N) + ' / ' + fmt(N); }
      else if (act === 5) { const G = 0.05 + 0.95 * sstep(0.32, 0.66, t); a = 'Pressure ' + G.toFixed(2); b = 'Fractured ' + fmt(fractured); }
      else if (act === 6) { a = 'Futures 8'; b = 'Run ' + fmt(Math.min(10000, 1 + (time - runStart) * 460)) + ' / 10,000'; }
      if (hudA.textContent !== a) hudA.textContent = a;
      if (hudB.textContent !== b) hudB.textContent = b;
    }

    function frame(now: number) {
      raf = 0;
      if (document.hidden || reduce || off) { last = 0; return; }
      const dt = last ? Math.min(1 / 30, (now - last) / 1000) : 1 / 60;
      last = now; frameDt = dt; still = false;
      if (HOME && act >= 8) measure(); // the lower sections move with the page
      if (!HOME) measureHead();
      step(dt);
      draw();
      if (now - hudT > 100) { hud(); hudT = now; }
      raf = requestAnimationFrame(frame);
    }

    // reduced motion: everything at rest at its target, drawn once
    function drawStill() { time = 14; still = true; step(0, true); draw(); hud(); }

    // start from this page's own shape (the ridge, on home)
    layout();
    if (!HOME) { act = SHAPE[PAGE] ?? 30; measureHead(); }
    for (let i = 0; i < N; i++) { target(i, act, 0, 0, 0); px[i] = tx; py[i] = ty; pz[i] = tz; ca[i] = 0; ch[i] = th; cs[i] = ts; }
    let scrollRaf = 0;
    addEventListener('scroll', () => { if (!scrollRaf) scrollRaf = requestAnimationFrame(() => { scrollRaf = 0; readScroll(); }); }, { passive: true });
    addEventListener('resize', () => { layout(); readScroll(); });
    document.addEventListener('visibilitychange', () => { if (!document.hidden && !reduce && !off && !raf) raf = requestAnimationFrame(frame); });
    reduceMq.addEventListener('change', () => { reduce = reduceMq.matches; readScroll(); });
    let hoverRaf = 0;
    addEventListener('pointerover', () => { if (reduce && !hoverRaf) hoverRaf = requestAnimationFrame(() => { hoverRaf = 0; drawStill(); }); }, { passive: true });
    readScroll();
  }
</script>
