---
// The swarm: one WebGL2 canvas fixed behind the whole home page.
//
// Every dot is an agent with a measured "pressure response" (s, 0 calm to 1 volatile).
// Colour is heat: blue when calm, through bone and amber, to red under pressure.
// Every block on the page with a data-act drives what the swarm does while it holds the middle of the screen:
//   0 ridge      the population draws the Alps at dusk: a bright ridgeline, the dark mass under it, a few stars (hero)
//   1 player     one player; scroll raises the pressure and his movement changes
//   2 network    communities: hubs, members, links, messages; a crisis spreads from one server to the next
//   3 scale      thousands of agents in many communities
//   4 record     the swarm becomes a dataset; a scan line records it row by row
//   5 swarm      free agents; scroll raises pressure on everyone, the cursor is local pressure
//   6 forward    the population runs forward along branching futures
//   7 horizon    the agents settle into the site's horizon line
//   8 dispatches a quiet field; the amber lines under the articles are drawn in dots (see 'lines')
//   9 road       the sun itself, a shaded sphere of dots, with a corona and embers rising off it
//  10 work       a quiet field; the lines under the products are drawn in dots
//  11 close      the clover again
// Lines: every amber line the page draws on this page (under articles, products and links) is hidden in CSS and
// redrawn here in dots, at the width CSS is animating it to, so hover still stretches it.
// No dependencies: raw WebGL2, a few typed arrays, two draw calls per frame.
// Reduced motion: no loop; the swarm is drawn once, settled, whenever the act changes.
//
// Other pages (Base.astro picks the page by path) get one shape in their header, then a quiet field:
//  20 journal    a pen of dots writing lines of text      21 article   the same, smaller; still below the title
//  22 press      a broadcast pulsing out from one point   23 work      a setting sun on a horizon
//  24 projects   one small community per project          25 lost      the dots drift and scatter (404)
//  30 field      the quiet star field under every header  31 still     nothing moving (an article's body)
// Article light mode switches the whole layer off.
//
// Paint (the home page; /restrained keeps the dots): the same agents and acts, painted. Each agent is a brushstroke laid along its own motion
// and a flow field, onto a canvas that keeps its paint and slowly dries back to night blue, so the picture is always
// being repainted. Pressure is turbulence: calm lays long level strokes, pressure winds the field into Van Gogh's
// eddies and turns the strokes from Prussian blue through lemon to chrome yellow. A few thousand free strokes paint
// the sky between the agents. The canvas is lit as impasto when it is shown.
interface Props { page?: 'home' | 'journal' | 'article' | 'press' | 'work' | 'story' | 'projects' | 'lost'; paint?: boolean }
const { page = 'home', paint = false } = Astro.props;
const home = page === 'home';
---
<div class="t-bg" aria-hidden="true" data-page={page} data-paint={paint ? '1' : undefined}>
  <canvas id="swarm"></canvas>
  {home && <div class="t-sky"></div>}
  {home && paint && <div class="t-scrim"></div>}
  <div class="t-shade"></div>
  <div class="t-grain"></div>
</div>
<canvas class="t-top" aria-hidden="true"></canvas>
{home && <div class="t-hud" aria-hidden="true"><span class="t-hud-a"></span><span class="t-hud-b"></span></div>}
{home && <ol class="t-rail" aria-hidden="true">
  <li data-a="1"><span>What I saw</span></li>
  <li data-a="2"><span>Where people gather</span></li>
  <li data-a="3"><span>What I noticed next</span></li>
  <li data-a="4"><span>Why it matters</span></li>
  <li data-a="5"><span>What I believe</span></li>
  <li data-a="6"><span>Where this goes</span></li>
</ol>}

<style is:global>
  /* the amber lines are drawn by the swarm in dots; CSS keeps their size and timing so hover still stretches them */
  html:has(.t-bg):not([data-theme="light"]):not(.no-gl) :is(.credit,.prod,.card,.wcard,a.prow)::after,
  html:has(.t-bg):not([data-theme="light"]):not(.no-gl) main .slit i{background:transparent !important;box-shadow:none !important}
  html[data-theme="light"] .t-bg,html[data-theme="light"] .t-top{display:none}
  /* the lines' own layer: above the page (cards, photos), under the nav */
  .t-top{position:fixed;left:0;top:0;width:100%;height:100lvh;z-index:60;pointer-events:none}
  /* paint: the closing fade and the footer settle into night blue, not charcoal */
  html:has(.t-bg[data-paint]) .close.grained{background:linear-gradient(180deg,rgba(16,24,48,0) 0%,rgba(14,21,42,.45) 45%,#0E1630 100%)}
  html:has(.t-bg[data-paint]) .close.grained::after{opacity:.14}
  html:has(.t-bg[data-paint]) body > footer{background:linear-gradient(180deg,#0E1630 0%,#0B1226 45%,#080D1C 100%);border-top:0}
  html:has(.t-bg[data-paint]) body > footer::after{opacity:.14}
  html:has(.t-bg[data-paint]) .foot small{color:rgba(196,206,230,.55)}
  html:has(.t-bg[data-paint]) .foot nav a{color:#C9D2E6}
  html:has(.t-bg[data-paint]) .enav-bar{background:rgba(10,15,32,.74)}
  /* paint: the hero's words sit on a little shadow of their own, so the sky can stay wild around them */
  html:has(.t-bg[data-paint]) :is(.t-h1,.t-belief,.t-lede,.t-cue){text-shadow:0 1px 2px rgba(6,10,24,.9),0 0 18px rgba(6,10,24,.85),0 0 42px rgba(6,10,24,.6)}
</style>

<style>
  .t-bg{position:fixed;inset:0;z-index:-1;pointer-events:none;background:#0B0B0B}
  #swarm{position:absolute;left:0;top:0;width:100%;height:100lvh;display:block}
  /* the dusk behind the ridge (hero only): grey high up, rose toward the mountains, screened onto the dark */
  .t-sky{position:absolute;inset:0;opacity:0;mix-blend-mode:screen;transition:opacity 1.4s ease;
    background:linear-gradient(180deg,rgb(40,40,42) 0%,rgb(50,48,49) 35%,rgb(78,58,54) 62%,rgb(96,62,52) 74%,rgb(30,22,20) 86%,rgb(0,0,0) 100%)}
  :global(html[data-act="0"]) .t-sky,:global(html:not([data-act])) .t-sky{opacity:1}
  .t-shade{position:absolute;inset:0;opacity:0;transition:opacity 1.2s ease;
    background:linear-gradient(90deg,rgba(11,11,11,.92) 0%,rgba(11,11,11,.74) 28%,rgba(11,11,11,.18) 50%,rgba(11,11,11,0) 62%)}
  :global(html.t-story) .t-shade{opacity:1}
  /* paint: the canvas paints its own sky, on night blue */
  .t-bg[data-paint]{background:#101830}
  .t-bg[data-paint] .t-sky{display:none}
  /* a dark wash under the hero's words; it lifts as you scroll into the stars */
  .t-scrim{position:absolute;inset:0;pointer-events:none;opacity:calc(1 - var(--hz, 0) * 1.4);transition:opacity .4s ease;
    background:radial-gradient(46% 34% at 50% 42%,rgba(8,12,28,.82) 0%,rgba(8,12,28,.62) 45%,rgba(8,12,28,0) 100%)}
  :global(html[data-act]:not([data-act="0"])) .t-scrim{opacity:0}
  @media (max-width:700px){.t-scrim{background:radial-gradient(80% 40% at 50% 44%,rgba(8,12,28,.84) 0%,rgba(8,12,28,.6) 50%,rgba(8,12,28,0) 100%)}}
  .t-bg[data-paint] .t-shade{background:linear-gradient(90deg,rgba(9,13,26,.9) 0%,rgba(9,13,26,.7) 28%,rgba(9,13,26,.16) 50%,rgba(9,13,26,0) 62%)}
  .t-bg[data-paint] .t-grain{opacity:.07;box-shadow:inset 0 0 240px 70px rgba(4,6,14,.6)}
  @media (max-width:700px){.t-bg[data-paint] .t-shade{background:linear-gradient(0deg,rgba(9,13,26,.94) 0%,rgba(9,13,26,.8) 34%,rgba(9,13,26,.18) 56%,rgba(9,13,26,0) 66%)}}
  .t-grain{position:absolute;inset:0;background-image:var(--noise);background-size:180px;opacity:.11;filter:grayscale(1);mix-blend-mode:screen;
    box-shadow:inset 0 0 220px 60px rgba(0,0,0,.55)}
  @media (max-width:700px){
    .t-shade{background:linear-gradient(0deg,rgba(11,11,11,.96) 0%,rgba(11,11,11,.82) 34%,rgba(11,11,11,.2) 56%,rgba(11,11,11,0) 66%)}
  }
  /* no WebGL: the old page's light, still */
  :global(html.no-gl) .t-bg{background:radial-gradient(50% 60% at 70% 45%,rgba(232,163,61,.14),transparent 70%),radial-gradient(40% 50% at 20% 70%,rgba(128,168,214,.08),transparent 70%),#0B0B0B}

  .t-hud{position:fixed;left:max(24px,calc(50% - 576px));bottom:26px;z-index:5;display:flex;flex-direction:column;gap:8px;pointer-events:none;
    font:500 11px/1 var(--mono);letter-spacing:.22em;text-transform:uppercase;color:var(--dim);opacity:0;transition:opacity .6s ease}
  .t-hud-b{color:var(--accent)}
  .t-hud span:empty{display:none}
  :global(html.t-live) .t-hud{opacity:1}
  .t-rail{position:fixed;right:28px;top:50%;z-index:5;transform:translateY(-50%);list-style:none;margin:0;padding:0;
    display:flex;flex-direction:column;gap:18px;pointer-events:none;opacity:0;transition:opacity .6s ease}
  .t-rail li{display:flex;align-items:center;justify-content:flex-end;gap:12px;font:500 11px/1 var(--mono);letter-spacing:.22em;text-transform:uppercase;color:rgba(232,232,219,.28);transition:color .5s ease}
  .t-rail li span{max-width:0;overflow:hidden;opacity:0;transition:max-width .6s ease,opacity .6s ease;white-space:nowrap}
  .t-rail li.on span{max-width:240px;opacity:1}
  .t-rail li::after{content:"";width:7px;height:7px;border-radius:50%;background:currentColor;transition:background .5s,box-shadow .5s}
  .t-rail li.on{color:var(--accent)}
  .t-rail li.on::after{box-shadow:0 0 14px 2px rgba(var(--accent-rgb),.7)}
  .t-rail li.past{color:rgba(232,232,219,.5)}
  :global(html.t-story) .t-rail{opacity:1}
  @media (max-width:900px){.t-rail{display:none}}
  @media (max-width:700px){.t-hud{top:66px;bottom:auto;left:16px;font-size:10px}}
</style>

<script>
  const root = document.documentElement;
  const bg = document.querySelector<HTMLElement>('.t-bg');
  const canvas = document.querySelector<HTMLCanvasElement>('#swarm');
  const hudA = document.querySelector<HTMLElement>('.t-hud-a');
  const hudB = document.querySelector<HTMLElement>('.t-hud-b');
  const railItems = Array.from(document.querySelectorAll<HTMLElement>('.t-rail li'));
  const steps = Array.from(document.querySelectorAll<HTMLElement>('main [data-act]'));

  const PAGE = (bg?.dataset.page || 'home') as string, HOME = PAGE === 'home', PAINT = bg?.dataset.paint === '1';
  if (bg && canvas && (steps.length || !HOME)) {
    const reduceMq = matchMedia('(prefers-reduced-motion: reduce)');
    let reduce = reduceMq.matches;
    const small = matchMedia('(max-width: 700px)').matches || (navigator.hardwareConcurrency || 8) <= 4;
    const STORY0 = 1, STORY1 = 6; // the numbered acts

    const clamp = (x: number, a = 0, b = 1) => (x < a ? a : x > b ? b : x);
    const sstep = (a: number, b: number, x: number) => { const u = clamp((x - a) / (b - a)); return u * u * (3 - 2 * u); };
    const fract = (x: number) => x - Math.floor(x);

    // ---------- viewport ----------
    let W = 1, H = 1, A = 1, dpr = 1, wide = true;
    const wx = (cx: number) => (cx / W * 2 - 1) * A;
    const wy = (cy: number) => -(cy / H * 2 - 1);

    // ---------- scroll: which act, how far through it, and where the page's own shapes are ----------
    let act = 0, t = 0, lastAct = -1, hz = 0;
    const heroStep = document.querySelector<HTMLElement>('.t-hero');
    const sky = document.querySelector<HTMLElement>('.t-sky');
    let sunX = 0, sunY = -1, sunR = 0.5;                              // road
    let closeX = 0, closeY = 0;                                      // send word
    const sun = document.querySelector<HTMLElement>('.orb-sun');
    const closeH = document.querySelector<HTMLElement>('#contact .h1');

    function measure() {
      if (act === 9 && sun) {
        const r = sun.getBoundingClientRect();
        sunX = wx(r.left + r.width / 2); sunY = wy(r.top + r.height / 2); sunR = (r.width / H);
      } else if (act === 11 && closeH) {
        const r = closeH.getBoundingClientRect();
        closeX = wx(r.left + r.width / 2); closeY = wy(r.top + r.height / 2);
      }
    }

    // other pages: the header (and where a shape can sit beside its words), then everything below it
    const SHAPE: Record<string, number> = { journal: 20, article: 21, press: 22, work: 23, story: 30, projects: 24, lost: 25 };
    const head = HOME ? null : document.querySelector<HTMLElement>('main .page-head, main .article-head, main .fx-hero');
    let hx0 = -1, hx1 = 1, hy0 = -1, hy1 = 1, nProj = Math.max(1, document.querySelectorAll('main .wcard').length);
    function measureHead() {
      if (!head) return;
      const r = head.getBoundingClientRect(), wrap = Math.min(r.width, 1200);
      let left = wide ? r.left + wrap * 0.5 : r.left, right = wide ? r.left + wrap : r.right;
      if (PAGE === 'article' && wide) {
        // an article's title is a narrow centred column: write in the free margin to its right, if there is one
        const t = head.querySelector('.h1')?.getBoundingClientRect() ?? r, room = innerWidth - 48 - (t.right + 40);
        if (room > 180) { left = t.right + 40; right = innerWidth - 48; }
      }
      if (PAGE === 'press' && wide) { left = r.left + wrap * 0.62; right = r.left + wrap; }
      if (!wide) { left = r.left + r.width * 0.52; right = r.right - 8; } // phones: the right side, clear of most titles
      hx0 = wx(left); hx1 = wx(right); hy1 = wy(Math.max(r.top + (wide ? 70 : 60), 60)); hy0 = wy(r.bottom);
    }
    function readInner() {
      let a = SHAPE[PAGE] ?? 30;
      if (head) { const r = head.getBoundingClientRect(); if (r.bottom < r.height * 0.5) a = PAGE === 'article' ? 31 : 30; } // half the header scrolled away
      act = a; t = 0.5;
      measureHead();
      if (act !== lastAct) { root.dataset.act = String(act); lastAct = act; }
      if (reduce || off) drawStill();
      else if (!raf) raf = requestAnimationFrame(frame);
    }

    function readScroll() {
      if (!HOME) return readInner();
      const c = innerHeight * 0.5;
      let found = false;
      for (const el of steps) {
        const r = el.getBoundingClientRect();
        if (r.top <= c && r.bottom > c) { act = Number(el.dataset.act) || 0; t = (c - r.top) / r.height; found = true; break; }
      }
      if (!found) {
        const first = steps[0].getBoundingClientRect();
        if (first.top > c) { act = 0; t = 0; } else { act = 11; t = 1; }
      }
      if (heroStep) { // how far into the opening scroll: 0 at the top, 1 once the look up is done
        const r = heroStep.getBoundingClientRect();
        hz = clamp(-r.top / (r.height * 0.55));
        root.style.setProperty('--hz', hz.toFixed(3));
        if (sky) sky.style.opacity = act === 0 ? String(1 - sstep(0, 0.7, hz)) : '0';
      }
      measure();
      if (act !== lastAct) {
        root.dataset.act = String(act);
        root.classList.toggle('t-story', act >= STORY0 && act <= STORY1);
        railItems.forEach((li) => { const a = Number(li.dataset.a); li.classList.toggle('on', a === act); li.classList.toggle('past', a < act); });
        if (act === 6) runStart = time;
        lastAct = act;
      }
      root.classList.toggle('t-live', act >= STORY0 && act <= STORY1 && t > 0.24 && t < 0.76);
      if (reduce) drawStill();
      else if (!raf) raf = requestAnimationFrame(frame);
    }

    // article light mode: the layer is hidden, so stop drawing it
    let off = root.dataset.theme === 'light';
    new MutationObserver(() => { const o = root.dataset.theme === 'light'; if (o !== off) { off = o; if (!off) { last = 0; readScroll(); } } }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });

    // ---------- GL ----------
    const gl = canvas.getContext('webgl2', { antialias: false, alpha: false, depth: false, stencil: false, powerPreference: 'high-performance' }) as WebGL2RenderingContext | null;
    if (!gl) root.classList.add('no-gl');

    const VS = `#version 300 es
layout(location=0) in vec3 aPos;
layout(location=1) in vec4 aCol;
layout(location=2) in float aSize;
uniform vec2 uScale;
uniform float uDpr;
out vec4 vCol;
void main(){
  float d = 1.0 / (1.0 + aPos.z * 0.12);
  gl_Position = vec4(aPos.xy * d * uScale, 0.0, 1.0);
  gl_PointSize = aSize * uDpr * d;
  vCol = aCol;
}`;
    const FS = `#version 300 es
precision mediump float;
in vec4 vCol;
out vec4 o;
void main(){
  vec2 q = gl_PointCoord * 2.0 - 1.0;
  float r = dot(q, q);
  if (r > 1.0) discard;
  float a = (exp(-r * 7.0) + exp(-r * 2.2) * 0.22) * vCol.a;
  o = vec4(vCol.rgb * a, 1.0);
}`;
    const LVS = `#version 300 es
layout(location=0) in vec2 aPos;
layout(location=1) in vec4 aCol;
uniform vec2 uScale;
out vec4 vCol;
void main(){ gl_Position = vec4(aPos * uScale, 0.0, 1.0); vCol = aCol; }`;
    const LFS = `#version 300 es
precision mediump float;
in vec4 vCol;
out vec4 o;
void main(){ o = vec4(vCol.rgb * vCol.a, vCol.a); }`;

    // ---------- the population ----------
    const N = small ? 4200 : 9000, TRAIL = 160, RING = 72, C = 7, HUBS = 16, MSG = small ? 140 : 260;
    // the page's amber lines: a line on screen borrows a block of dots, one per CSS pixel or so, so it reads solid;
    // it hands the block back when it leaves the screen
    const SP = small ? 1.1 : 1, HSP = 4; // px between dots, and between the soft glow dots under them
    type Src = { el: HTMLElement; pseudo: boolean; blk: number };
    const lineSrc: Src[] = [
      ...Array.from(document.querySelectorAll<HTMLElement>('main :is(.credit,.prod,.card,.wcard,a.prow)')).map((el) => ({ el, pseudo: true, blk: -1 })),
      ...Array.from(document.querySelectorAll<HTMLElement>('main .slit i')).map((el) => ({ el, pseudo: false, blk: -1 })),
    ];
    const KB = small ? 8 : 14, B = Math.ceil(Math.min(1400, Math.max(innerWidth, 360)) / SP), HB = Math.ceil((B * SP) / HSP);
    const freeB: number[] = []; for (let k = KB - 1; k >= 0; k--) freeB.push(k);
    const LC = KB * B;
    const oTrail = N, oHub = N + TRAIL, oMsg = oHub + HUBS, M = oMsg + MSG;
    let seed = 20261119;
    const rnd = () => { seed = (seed + 0x6d2b79f5) | 0; let q = Math.imul(seed ^ (seed >>> 15), 1 | seed); q = (q + Math.imul(q ^ (q >>> 7), 61 | q)) ^ q; return ((q ^ (q >>> 14)) >>> 0) / 4294967296; };
    const gauss = () => { const u = Math.max(1e-6, rnd()), v = rnd(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); };

    const sx = new Float32Array(N), sy = new Float32Array(N), gx = new Float32Array(N), gy = new Float32Array(N);
    const sens = new Float32Array(N), stiff = new Float32Array(N), ph = new Float32Array(N), br = new Float32Array(N), z0 = new Float32Array(N);
    const cl = new Uint8Array(N), leaf = new Uint8Array(N), rankL = new Uint32Array(N), rankH = new Float32Array(N);
    const cfx = new Float32Array(N), cfy = new Float32Array(N), cleaf = new Uint8Array(N);
    const comm = new Uint8Array(N), hubOf = new Uint8Array(N); // network: which community, which hub in it
    const udx = new Float32Array(N), udy = new Float32Array(N); // a point in the unit disc (the sun)
    const px = new Float32Array(N), py = new Float32Array(N), pz = new Float32Array(N), vx = new Float32Array(N), vy = new Float32Array(N);
    const ca = new Float32Array(N), ch = new Float32Array(N), cs = new Float32Array(N), hT = new Float32Array(N), lastU = new Float32Array(N);

    const cw = [0.22, 0.18, 0.16, 0.14, 0.12, 0.1, 0.08];
    const cTheta = cw.map((_, j) => (j / C) * Math.PI * 2 + rnd() * 0.5);
    const cRad = cw.map((w) => 0.07 + w * 0.42);
    const leafP = [0.3, 0.04, 0.17, 0.03, 0.22, 0.05, 0.13, 0.06];
    const commW = [0.34, 0.26, 0.22, 0.18], hubW = [0.46, 0.18, 0.18, 0.18];
    // the ridgeline, traced from the Alps photo (alps-x-brown.png): 241 heights, fraction of the image's height from its top
    const RIDGE = [.772,.77,.77,.77,.772,.774,.774,.776,.776,.778,.778,.778,.78,.782,.782,.782,.782,.782,.784,.784,.786,.788,.788,.788,.788,.788,.79,.79,.792,.792,.792,.792,.79,.782,.78,.78,.784,.786,.786,.784,.778,.768,.76,.756,.756,.756,.748,.74,.74,.74,.736,.728,.72,.712,.712,.712,.71,.708,.702,.698,.692,.692,.698,.704,.708,.708,.71,.708,.708,.7,.7,.702,.704,.704,.69,.68,.674,.668,.662,.65,.638,.634,.63,.63,.632,.636,.646,.656,.66,.66,.672,.688,.7,.708,.71,.71,.71,.712,.712,.71,.704,.698,.698,.698,.706,.714,.72,.732,.742,.742,.742,.736,.73,.724,.718,.708,.704,.704,.704,.696,.688,.686,.682,.68,.68,.686,.686,.686,.68,.672,.668,.668,.664,.658,.658,.658,.66,.668,.668,.664,.658,.648,.632,.618,.614,.61,.598,.58,.57,.57,.58,.592,.602,.618,.63,.638,.642,.646,.648,.658,.672,.682,.692,.698,.698,.69,.684,.684,.686,.686,.676,.662,.652,.652,.656,.668,.676,.678,.678,.68,.682,.686,.688,.696,.708,.716,.716,.718,.728,.732,.734,.738,.738,.736,.728,.724,.724,.726,.726,.72,.714,.714,.714,.714,.714,.708,.706,.706,.714,.722,.728,.732,.736,.74,.746,.752,.752,.748,.742,.736,.73,.73,.728,.728,.728,.732,.736,.74,.744,.744,.744,.738,.738,.734,.734,.736,.736,.736,.73,.722,.722];
    const ridgeAt = (u: number) => { const f = clamp(u) * (RIDGE.length - 1), k = Math.min(RIDGE.length - 2, Math.floor(f)), w = f - k; return RIDGE[k] * (1 - w) + RIDGE[k + 1] * w; };
    const pick = (ws: number[]) => { let r = rnd(), k = 0; for (; k < ws.length - 1; k++) { r -= ws[k]; if (r < 0) break; } return k; };

    for (let i = 0; i < N; i++) {
      sx[i] = rnd() * 2 - 1; sy[i] = rnd() * 2 - 1;
      gx[i] = gauss(); gy[i] = gauss();
      sens[i] = Math.pow(rnd(), 1.7);
      stiff[i] = 1.6 + rnd() * 3.4;
      ph[i] = rnd() * Math.PI * 2;
      br[i] = 0.55 + rnd() * 0.45;
      z0[i] = rnd() * 2 - 1;
      cl[i] = pick(cw);
      leaf[i] = pick(leafP);
