      let o = 1, n: HTMLElement | null = el;
      for (let d = 0; n && d < 8 && n.tagName !== 'MAIN'; d++, n = n.parentElement) { o *= Number(getComputedStyle(n).opacity); if (o < 0.01) return 0; }
      return o;
    }
    function lines(dt: number, snap: boolean) {
      const px1 = 2 / H, sp = SP * px1, lock = 1.6 * px1;
      const fdec = snap ? 1 : Math.min(1, dt * 7), k = 24, k2 = k * k, damp = 2 * k * 0.9;
      for (const g of lineSrc) {
        const r = g.el.getBoundingClientRect(), vis = r.bottom > -40 && r.top < innerHeight + 40;
        let x0 = 0, len = 0, y = 0, op = 0;
        if (vis) {
          let lx0 = r.left, w = r.width, yy = r.top + r.height / 2;
          if (g.pseudo) { const cs = getComputedStyle(g.el, '::after'); w = parseFloat(cs.width) || 0; lx0 = r.left + (parseFloat(cs.left) || 0); yy = r.bottom - 1; }
          op = w > 0.5 ? seen(g.el) : 0;
          x0 = wx(lx0); len = w; y = wy(yy);
        }
        for (let q = 0; q < g.cap; q++) {
          const j = g.at + q, o = oLine + j, o3 = o * 3, o4 = o * 4;
          const want = op > 0.02 && (q + 0.5) * SP <= len;
          const sx0 = x0 + (q + 0.5) * sp, sy0 = y;
          if (!vis) { lst[j] = 0; la[j] = 0; }
          else if (want) {
            if (snap) { lst[j] = 2; la[j] = op * LINE_A; }
            if (lst[j] === 0 || lst[j] === 3) {
              if (lst[j] === 0) { // leave from a swarm agent, the nearest of three picked at random
                let best = 0, bd = 1e9;
                for (let t2 = 0; t2 < 3; t2++) { const a = (Math.random() * N) | 0, d = (px[a] - sx0) ** 2 + (py[a] - sy0) ** 2; if (d < bd) { bd = d; best = a; } }
                lfrom[j] = best; lx[j] = px[best]; ly[j] = py[best]; lvx[j] = 0; lvy[j] = 0;
              }
              lst[j] = 1;
            }
            if (lst[j] === 1) {
              lvx[j] += ((sx0 - lx[j]) * k2 - lvx[j] * damp) * dt; lvy[j] += ((sy0 - ly[j]) * k2 - lvy[j] * damp) * dt;
              lx[j] += lvx[j] * dt; ly[j] += lvy[j] * dt;
              if (Math.abs(sx0 - lx[j]) < lock && Math.abs(sy0 - ly[j]) < lock) lst[j] = 2;
            }
            if (lst[j] === 2) { lx[j] = sx0; ly[j] = sy0; }
            la[j] += (op * LINE_A - la[j]) * fdec;
          } else if (lst[j] === 1 || lst[j] === 2 || lst[j] === 3) {
            // let go: drift back toward the agent it came from, fading
            const a = lfrom[j];
            lst[j] = 3; lx[j] += (px[a] - lx[j]) * Math.min(1, dt * 2.5); ly[j] += (py[a] - ly[j]) * Math.min(1, dt * 2.5);
            la[j] *= snap ? 0 : Math.max(0, 1 - dt * 4);
            if (la[j] < 0.01) { lst[j] = 0; la[j] = 0; }
          }
          pos[o3] = lx[j]; pos[o3 + 1] = ly[j]; pos[o3 + 2] = 0;
          heatRGB(lst[j] === 2 ? LINE_H : 0.6, col, o4, 1);
          col[o4 + 3] = la[j] * (lst[j] === 2 ? 1 : 1.8); size[o] = lst[j] === 2 ? 5 : 4.5;
        }
        // the glow under the line, where it has formed
        for (let h = 0; h < g.hcap; h++) {
          const o = oLine + LC + g.hat + h, o3 = o * 3, o4 = o * 4, q = Math.min(g.cap - 1, Math.floor(((h + 0.5) * HSP) / SP));
          const on = vis && lst[g.at + q] === 2 ? la[g.at + q] / LINE_A : 0;
          pos[o3] = x0 + (h + 0.5) * HSP * px1; pos[o3 + 1] = y; pos[o3 + 2] = 0;
          heatRGB(LINE_H, col, o4, 1); col[o4 + 3] = 0.035 * on; size[o] = 28;
        }
      }
    }

    function draw() {
      if (!gl || !prog || !lprog) return;
      gl.clear(gl.COLOR_BUFFER_BIT);
      if (netA > 0.01 && lineCount) {
        gl.useProgram(lprog); gl.bindVertexArray(vaoL);
        gl.bindBuffer(gl.ARRAY_BUFFER, bLPos); gl.bufferSubData(gl.ARRAY_BUFFER, 0, lpos);
        gl.bindBuffer(gl.ARRAY_BUFFER, bLCol); gl.bufferSubData(gl.ARRAY_BUFFER, 0, lcol);
        gl.drawArrays(gl.LINES, 0, lineCount * 2);
      }
      gl.useProgram(prog); gl.bindVertexArray(vaoP);
      gl.bindBuffer(gl.ARRAY_BUFFER, bPos); gl.bufferSubData(gl.ARRAY_BUFFER, 0, pos);
      gl.bindBuffer(gl.ARRAY_BUFFER, bCol); gl.bufferSubData(gl.ARRAY_BUFFER, 0, col);
      gl.bindBuffer(gl.ARRAY_BUFFER, bSize); gl.bufferSubData(gl.ARRAY_BUFFER, 0, size);
      gl.drawArrays(gl.POINTS, 0, M);
    }

    const fmt = (n: number) => Math.round(n).toLocaleString('en-GB');
    function hud() {
      if (!hudA || !hudB) return;
      let a = '', b = '';
      if (act === 1) {
        const P = sstep(0.34, 0.64, t);
        a = P < 0.5 ? 'Score 12–3 · Economy full' : 'Score 11–12 · Economy broken';
        b = 'Pressure ' + P.toFixed(2);
      } else if (act === 2) {
        const reached = crisis.reduce((n, c) => n + (c > 0.5 ? 1 : 0), 0);
        a = 'Servers 4 · Members ' + fmt(N); b = reached ? 'Crisis reached ' + reached + ' / 4' : 'Messages flowing';
      } else if (act === 3) { a = 'Communities ' + C; b = 'Agents ' + fmt(N); }
      else if (act === 4) { a = 'Recording'; b = 'Rows ' + fmt(Math.min(1, lt() * 1.02) * N) + ' / ' + fmt(N); }
      else if (act === 5) { const G = 0.05 + 0.95 * sstep(0.32, 0.66, t); a = 'Pressure ' + G.toFixed(2); b = 'Fractured ' + fmt(fractured); }
      else if (act === 6) { a = 'Futures 8'; b = 'Run ' + fmt(Math.min(10000, 1 + (time - runStart) * 460)) + ' / 10,000'; }
      if (hudA.textContent !== a) hudA.textContent = a;
      if (hudB.textContent !== b) hudB.textContent = b;
    }

    function frame(now: number) {
      raf = 0;
      if (document.hidden || reduce) { last = 0; return; }
      const dt = last ? Math.min(1 / 30, (now - last) / 1000) : 1 / 60;
      last = now;
      if (act >= 8) measure(); // the lower sections move with the page
      step(dt);
      draw();
      if (now - hudT > 100) { hud(); hudT = now; }
      raf = requestAnimationFrame(frame);
    }

    // reduced motion: everything at rest at its target, drawn once
    function drawStill() { time = 14; step(0, true); draw(); hud(); }

    // start from the clover
    layout();
    for (let i = 0; i < N; i++) { target(i, 0, 0, 0, 0); px[i] = tx; py[i] = ty; pz[i] = tz; ca[i] = 0; ch[i] = th; cs[i] = ts; }
    let scrollRaf = 0;
    addEventListener('scroll', () => { if (!scrollRaf) scrollRaf = requestAnimationFrame(() => { scrollRaf = 0; readScroll(); }); }, { passive: true });
    addEventListener('resize', () => { layout(); readScroll(); });
    document.addEventListener('visibilitychange', () => { if (!document.hidden && !reduce && !raf) raf = requestAnimationFrame(frame); });
    reduceMq.addEventListener('change', () => { reduce = reduceMq.matches; readScroll(); });
    let hoverRaf = 0;
    addEventListener('pointerover', () => { if (reduce && !hoverRaf) hoverRaf = requestAnimationFrame(() => { hoverRaf = 0; drawStill(); }); }, { passive: true });
    readScroll();
  }
</script>
